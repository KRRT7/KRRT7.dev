{
  "name": "krrt7.dev",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bun --hot src/server/bun-server.ts",
    "build": "bun run src/scripts/build-pages-static.ts",
    "start": "bun run src/server/bun-server.ts",
    "deploy": "bun install --frozen-lockfile && bun run build && wrangler pages deploy .cache/pages --project-name krrt7-dev --branch master",
    "audit": "bun run src/scripts/audit.ts",
    "perf:paint": "bun run src/scripts/paint-benchmark.ts",
    "perf:remote": "bun run src/scripts/remote-perf.ts"
  },
  "postcss": {
    "plugins": {
      "tailwindcss": {
        "config": "./src/tailwind.config.ts"
      }
    }
  },
  "dependencies": {
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@octokit/openapi-types": "^27.0.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "axe-core": "^4.12.1",
    "eslint": "^8",
    "lighthouse": "^13.4.0",
    "linkinator": "^7.6.1",
    "pa11y": "^9.1.1",
    "playwright": "^1.61.1",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
